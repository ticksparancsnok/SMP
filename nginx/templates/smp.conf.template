# SMP reverse proxy. Rendered at container start (envsubst) from
# nginx/templates/smp.conf.template; values come from .env:
#   SMP_SERVER_NAMES  SMP's own names/addresses (comma separated) -> the portal
#   anything else     a blocked site (the DNS sinkhole sends them here) -> block page

server_tokens off;

# Rate limits per client IP (also see the login throttle in server/smp/core/throttle.py).
limit_req_zone $binary_remote_addr zone=smp_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=smp_all:10m rate=20r/s;
# The agent download (/downloads/: ~4 MB, public). A few per minute per address is
# plenty (PCs spread their updates over minutes, also 30 behind one lab router), and
# nobody can fill the school's network with it (the general limit allowed ~600 Mbit/s).
limit_req_zone $binary_remote_addr zone=smp_download:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=smp_download_conn:10m;
# Remote control: the one controlled PC sends ~5 pictures a second and fetches the
# teacher's input as it comes (up to ~25 requests a second while the mouse moves).
limit_req_zone $binary_remote_addr zone=smp_remote:10m rate=50r/s;
limit_req_status 429;
limit_conn_status 429;

upstream smp_server {
    server server:8000;
    keepalive 16;
}
upstream smp_blockpage {
    server dns-sinkhole:8080;
}

# ------------------------------------------------------------------ HTTP (port 80)

server {  # SMP's names: always HTTPS
    listen 80;
    server_name ${SMP_NGINX_SERVER_NAMES};
    location / {
        return 301 https://$host${SMP_HTTPS_SUFFIX}$request_uri;
    }
}

server {  # everything else: blocked sites
    listen 80 default_server;
    server_name _;
    include /etc/nginx/snippets/blockpage.conf;
}

# ------------------------------------------------------------------ HTTPS (port 443)

server {  # blocked HTTPS sites: the browser warns about the certificate first
    listen 443 ssl default_server;
    server_name _;
    include /etc/nginx/snippets/tls.conf;
    include /etc/nginx/snippets/blockpage.conf;
}

server {  # the SMP portal
    listen 443 ssl;
    http2 on;
    server_name ${SMP_NGINX_SERVER_NAMES};
    include /etc/nginx/snippets/tls.conf;

    # User imports (.xlsx, hosts files) are uploaded as one request body.
    client_max_body_size 64m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header Referrer-Policy same-origin always;
    # No Strict-Transport-Security on purpose: with a self-signed certificate it
    # would stop browsers from letting users past the certificate warning. Add it
    # once a real certificate is in nginx/certs.

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    # $http_host keeps a non-default port, which the server's CSRF check compares
    # with the browser's Origin header.
    proxy_set_header Host $http_host;
    # Overwrite (don't append to) X-Forwarded-For, so clients can't fake their IP;
    # the server trusts these headers only from SMP's docker network.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;  # large imports

    location = /api/v1/auth/login {
        limit_req zone=smp_login burst=5 nodelay;
        proxy_pass http://smp_server;
    }
    # Software installers (server/smp/modules/software): an upload can be gigabytes, so
    # this one endpoint has no size limit here and streams the body on to the server
    # instead of storing it on nginx's disk first. The server enforces the real limit
    # (SMP_SOFTWARE_MAX_UPLOAD_BYTES) and needs an admin's session.
    location = /api/v1/software/uploads {
        limit_req zone=smp_all burst=40 nodelay;
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_pass http://smp_server;
    }
    # ...and the computers' downloads of them (signed agents only): passed straight
    # through, not copied to nginx's disk. The server limits how many run at once
    # (Settings -> Software deployment) and supports resuming (Range).
    location ^~ /api/v1/software/agent/packages/ {
        limit_req zone=smp_all burst=40 nodelay;
        proxy_buffering off;
        proxy_pass http://smp_server;
    }
    # Remote control, the teacher's side: a WebSocket (one long connection; the browser
    # sends input and gets the pictures on it). proxy_set_header here replaces the
    # server-level ones, so all of them are repeated.
    location ~ ^/api/v1/classroom/devices/[0-9a-fA-F-]+/remote$ {
        limit_req zone=smp_all burst=40 nodelay;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;  # a quiet session (the teacher only watches) stays open
        proxy_send_timeout 1h;
        proxy_pass http://smp_server;
    }
    # ...and the controlled PC's side (signed requests, more of them than the general limit allows)
    location ^~ /api/v1/classroom/agent/remote/ {
        limit_req zone=smp_remote burst=100 nodelay;
        proxy_pass http://smp_server;
    }
    location ^~ /downloads/ {
        limit_req zone=smp_download burst=10 nodelay;
        limit_conn smp_download_conn 4;
        proxy_pass http://smp_server;
    }
    location / {
        limit_req zone=smp_all burst=40 nodelay;
        proxy_pass http://smp_server;
    }
}
