# Copy to .env (git-ignored) and adjust. docker compose reads it automatically.
# Generate each secret below with
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Postgres password. Only applied when the database volume is first created.
SMP_DB_PASSWORD=change-me

# Required. Encrypts one-time passwords at rest (login slips). At least 32 characters.
# Keep it stable; to change it, follow "Rotating SMP_SECRET_KEY" in docs/security.md.
# In production prefer a file: SMP_SECRET_KEY_FILE=/run/secrets/smp_secret_key (chmod 600).
SMP_SECRET_KEY=

# true when a TLS reverse proxy is in front
# Only set this to false while testing, do not run it in a production enviroment.
SMP_COOKIE_SECURE=true

# Where the server pushes the blocklist. Inside Docker Compose this is the
# dns-sinkhole service name, not 127.0.0.1 (that would be the server container itself).
# When running the server outside Docker (server/README.md), use http://127.0.0.1:8080.
SMP_DNS_SINKHOLE_URL=http://dns-sinkhole:8080

# Required. Shared secret between the server and the DNS sinkhole: docker compose passes
# it to the sinkhole as DNS_SYNC_TOKEN, and every /api/blocklist/* call needs it as a
# Bearer token. Without it the sinkhole's API is disabled and blocklist changes can't sync.
SMP_DNS_SYNC_TOKEN=

# ---- nginx (the front door; ./install.sh fills these in)
# SMP's own names/addresses, comma separated. Requests for these get the portal;
# any other name reaching nginx is a blocked site and gets the block page. The
# self-signed certificate covers exactly these names. Empty: localhost,127.0.0.1.
SMP_SERVER_NAMES=
# This server's LAN address (give it a fixed IP, e.g. a DHCP reservation). The school's
# computers use it as their DNS server (port SMP_DNS_PORT), and blocked names resolve
# to it, where nginx shows the block page.
SMP_SINKHOLE_IP=
# DNS port on that address: 53 for clients (Windows only supports 53); e.g. 1053 to test
# on a machine whose port 53 is taken.
SMP_DNS_PORT=53
# Published ports, if 80/443 are taken on this machine.
SMP_HTTP_PORT=80
SMP_HTTPS_PORT=443
# Docker network for SMP's containers; change if it clashes with the school network.
SMP_DOCKER_SUBNET=172.31.255.0/24
