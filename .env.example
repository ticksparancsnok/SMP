# Copy to .env (git-ignored) and adjust. docker compose reads it automatically.
SMP_DB_PASSWORD=change-me
# Encrypts one-time passwords at rest (login slips). At least 32 characters; generate with
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep it stable; to change it, follow "Rotating SMP_SECRET_KEY" in docs/security.md.
# In production prefer a file: SMP_SECRET_KEY_FILE=/run/secrets/smp_secret_key (chmod 600).
SMP_SECRET_KEY=
# true when a TLS reverse proxy is in front; false only for plain-http testing
SMP_COOKIE_SECURE=false
SMP_DNS_SINKHOLE_URL=http://127.0.0.1:8080
# Use the same value in the Go schoolfilter Corefile's optional sync-token argument.
SMP_DNS_SYNC_TOKEN=
